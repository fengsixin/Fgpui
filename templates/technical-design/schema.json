{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "技术方案",
  "required": ["title", "author"],
  "properties": {
    "title": { "type": "string", "title": "文档标题", "minLength": 1 },
    "subtitle": { "type": "string", "title": "副标题" },
    "author": { "type": "string", "title": "作者 / 部门", "minLength": 1 },
    "version": { "type": "string", "title": "文档版本", "default": "V1.0" },
    "date": { "type": "string", "title": "编写日期" },
    "classification": { "type": "string", "title": "密级", "enum": ["公开", "内部", "秘密"], "default": "内部" },
    "summary": { "type": "string", "title": "摘要", "format": "textarea" },
    "revisions": {
      "type": "array",
      "title": "修订记录",
      "items": {
        "type": "object",
        "title": "修订",
        "required": ["version"],
        "properties": {
          "version": { "type": "string", "title": "版本", "minLength": 1 },
          "date": { "type": "string", "title": "日期" },
          "author": { "type": "string", "title": "修订人" },
          "description": { "type": "string", "title": "修订说明" }
        }
      }
    },
    "body": {
      "type": "string",
      "title": "正文（Typst 源码）",
      "description": "直接书写 Typst 标记：== 二级标题、- 列表、#table(...)、#image(...)、*加粗* 等",
      "format": "code"
    }
  }
}
